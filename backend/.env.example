# Copy this file to backend/.env (same folder as pom.xml) and fill in real values.
# The backend loads backend/.env automatically; real environment variables /
# IntelliJ run-configuration variables also work and take priority. This file itself
# contains NO real secrets and is safe to commit - never commit the actual
# .env or the real values below.

# ---- Database (PostgreSQL) ----
# Everyone who clones the project uses THEIR OWN local database, so these
# are per-machine values. Defaults are shown; only DB_PASSWORD is required.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=MainDatabase
DB_USERNAME=postgres
DB_PASSWORD=choose-a-local-postgres-password

# ---- JWT ----
JWT_SECRET=replace-with-a-long-random-string

# ---- First-admin seeding (backend/config/AdminSeeder.java) ----
# Only used on first boot, only if no ADMIN exists yet.
ADMIN_SEED_EMAIL=admin@yourcompany.com
ADMIN_SEED_PASSWORD=replace-with-a-real-password

# ---- Email / SMTP (Phase 3 - backend/service/impl/EmailServiceImpl.java) ----
# Leave SMTP_HOST blank to disable email sending entirely (safe default for
# local development - notifications still work in-app/WebSocket either way).
# Example values below are for Gmail SMTP with an App Password - any SMTP
# provider works the same way (SendGrid, Mailgun, your company's mail
# server, etc.), just change host/port accordingly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=replace-with-an-app-password-not-your-real-password
MAIL_FROM=no-reply@yourcompany.com
